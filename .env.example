APP_NAME="Pasantías FET"
# development = pruebas locales con datos de demostración · production = servidor real, sin datos de demostración
APP_ENV=development
# Carpeta donde queda la plataforma dentro del servidor web (vacío si está en la raíz del dominio)
APP_BASE_URL=/PruebaFet
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fet_intranet
DB_USER=root
DB_PASS=
